# Copy to .env and fill in. Never commit .env.

# Port the API listens on (default 3100)
PORT=3100

# Web search (/api/search, /api/news) — REQUIRED for search.
# Free tier at https://tavily.com
TAVILY_API_KEY=

# Search fallback, used automatically if Tavily fails (optional, recommended).
# https://serpapi.com
SERPAPI_KEY=

# NASA API key for APOD endpoint — get a free key at https://api.nasa.gov/
# DEMO_KEY works but is rate-limited (30 req/hr, 50 req/day)
NASA_API_KEY=DEMO_KEY

# Phone lookup enrichment (optional) — get a free key at https://numverify.com
# Free tier: 250 requests/month. Without this key, local validation still works.
# NUMVERIFY_API_KEY=
