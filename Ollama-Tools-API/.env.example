# NASA API key for APOD endpoint — get a free key at https://api.nasa.gov/
# DEMO_KEY works but is rate-limited (30 req/hr, 50 req/day)
NASA_API_KEY=DEMO_KEY

# Phone lookup enrichment (optional) — get a free key at https://numverify.com
# Free tier: 250 requests/month. Without this key, local validation still works.
# NUMVERIFY_API_KEY=